#set($rawBlock = $ctx.args.block)
#set($block = $rawBlock)
#if($util.isString($rawBlock))
  #set($block = $util.parseJson($rawBlock))
#end

#if($util.isNull($block) || !$util.isMap($block) || !$block.containsKey("attempts") || !$util.isList($block.attempts))
  $util.error("Invalid block payload for appendParticipantAttemptBlock")
#end

#set($newBlocks = [])
$util.qr($newBlocks.add($block))
{
  "version": "2018-05-29",
  "operation": "UpdateItem",
  "key": {
    "id": $util.dynamodb.toDynamoDBJson($ctx.args.participantId)
  },
  "update": {
    "expression": "SET #attempts = list_append(if_not_exists(#attempts, :emptyList), :newBlocks), #updatedAt = :updatedAt",
    "expressionNames": {
      "#attempts": "attempts",
      "#updatedAt": "updatedAt"
    },
    "expressionValues": {
      ":emptyList": $util.dynamodb.toDynamoDBJson([]),
      ":newBlocks": $util.dynamodb.toDynamoDBJson($newBlocks),
      ":updatedAt": $util.dynamodb.toDynamoDBJson($util.time.nowISO8601())
    }
  }
}
