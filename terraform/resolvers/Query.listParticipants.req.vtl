#set($filter = $ctx.args.filter)
#set($exp = "")
#set($expNames = {})
#set($expValues = {})

#if($filter.id && $filter.id.eq)
  #set($exp = "#id = :id")
  $util.qr($expNames.put("#id", "id"))
  $util.qr($expValues.put(":id", $util.dynamodb.toDynamoDB($filter.id.eq)))
#end

#if($filter.prolificPid && $filter.prolificPid.eq)
  #if($exp != "")
    #set($exp = "$exp AND #prolificPid = :prolificPid")
  #else
    #set($exp = "#prolificPid = :prolificPid")
  #end
  $util.qr($expNames.put("#prolificPid", "prolificPid"))
  $util.qr($expValues.put(":prolificPid", $util.dynamodb.toDynamoDB($filter.prolificPid.eq)))
#end

#if($exp != "")
{
  "version": "2018-05-29",
  "operation": "Scan",
  "filter": {
    "expression": "$exp",
    "expressionNames": $util.toJson($expNames),
    "expressionValues": $util.toJson($expValues)
  }
}
#else
{
  "version": "2018-05-29",
  "operation": "Scan"
}
#end
