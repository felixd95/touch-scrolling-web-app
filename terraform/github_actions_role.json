{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateAndRead",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "cloudfront:ListDistributions",
        "iam:ListOpenIDConnectProviders",
        "iam:GetOpenIDConnectProvider",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageTerraformResources",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    }
  ]
}

